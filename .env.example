# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# O .env NUNCA vai para o git.

# Chave usada para assinar a sessão e o token CSRF dos formulários.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Banco de dados. Caminho relativo do SQLite fica dentro da pasta instance/.
DATABASE_URL=sqlite:///gula.db

# Pasta onde ficam as fotos enviadas pelos usuários (relativa à raiz do projeto).
UPLOAD_FOLDER=app/static/uploads

# development: log em DEBUG e modo debug do Flask | production: log em INFO
APP_ENV=development
FLASK_DEBUG=1
